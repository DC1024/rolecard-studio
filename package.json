{
  "name": "rolecard-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rolecard/server dev",
    "build": "pnpm -r build",
    "bundle": "node scripts/build-bundle.mjs",
    "typecheck": "pnpm --filter @rolecard/shared --filter @rolecard/core build && pnpm -r typecheck",
    "lint": "eslint packages apps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
